# Server-side only. Do not place this value in the iOS app, Info.plist, or app bundle.
GEMINI_API_KEY=
PORT=8787

# Optional. When set, the proxy rejects any request whose X-App-Secret header doesn't match this
# value. Not a substitute for GEMINI_API_KEY's secrecy — it ships inside the app binary and can be
# recovered from it — but it blocks casual scripted abuse of the public /v1/extract endpoint. Must
# match LifeAdminApp/AppConfig.swift's geminiProxySharedSecret exactly. Leave unset to disable this
# check (the proxy still applies a best-effort per-IP rate limit either way).
APP_SHARED_SECRET=
